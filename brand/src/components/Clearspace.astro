---
import Logo from "./Logo.astro";
import Mark from "./Mark.astro";
---
<div class="cards cards--2">
  <figure class="diagram">
    <div class="diagram-stage clearspace"><div class="clearspace-box"><Logo variant="cyan" width="100%" /></div></div>
    <figcaption><strong>Clear space.</strong> Keep free space on every side equal to x: the height of the lowercase letters in zero. No text, edge or image inside it.</figcaption>
  </figure>
  <figure class="diagram">
    <div class="diagram-stage minsize">
      <div><Logo variant="cyan" width="96" /><p>96 px · 25 mm</p></div>
      <div><Mark variant="cyan" width="16" /><p>Mark 16 px</p></div>
    </div>
    <figcaption><strong>Minimum size.</strong> Full logo at least 96 px wide on screen and 25 mm in print. Below that, use the h-mark alone (as in the favicon), at least 16 px.</figcaption>
  </figure>
</div>
