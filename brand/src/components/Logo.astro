---
// The hzero logo: the h-mark and the lowercase "zero", always in one colour.
// The h is cut out of the mark, so the background shows through.
// Geometry exported from the brand Figma (MCP 1 page), in src/lib/logo-geometry.json.
import geo from "../lib/logo-geometry.json";
type Variant = "cyan" | "charcoal" | "light";
interface Props { variant?: Variant | "signal" | "white"; width?: number | string; label?: string }
const { variant = "cyan", width = "100%", label = "hzero" } = Astro.props;
const fill = { cyan: "#2ECCD4", signal: "#2ECCD4", charcoal: "#091314", light: "#F7F7F7", white: "#F7F7F7" }[variant];
---
<svg class="logo" viewBox={geo.logo.viewBox} width={width} role="img" aria-label={label} fill="none" xmlns="http://www.w3.org/2000/svg">
  <g fill={fill}>
    {geo.logo.letters.map((d) => <path d={d} />)}
    <path class="logo-mark" fill-rule="evenodd" d={`${geo.logo.box} ${geo.logo.h}`} />
  </g>
</svg>
